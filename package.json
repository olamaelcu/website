{
	"name": "olamaelcu-landing",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "tsx scripts/generate-commit.ts && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "playwright install && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@awesome.me/webawesome": "^3.5.0",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.3",
		"autoprefixer": "^10.5.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.59.1",
		"postcss": "^8.5.12",
		"postcss-custom-media": "^12.0.1",
		"postcss-nested": "^7.0.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	},
	"packageManager": "yarn@4.14.1",
	"dependencies": {
		"@fontsource/inconsolata": "^5.2.8",
		"@fontsource/kalnia": "^5.2.9",
		"@fontsource/space-grotesk": "^5.2.10",
		"@fontsource/tourney": "^5.2.8",
		"@libsql/client": "^0.14.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sentry/sveltekit": "^10",
		"@tanstack/svelte-query": "^6.1.28",
		"drizzle-orm": "^0.43.0",
		"gray-matter": "^4.0.3",
		"marked": "^18.0.3",
		"plausible-tracker": "^0.3.9",
		"satori": "^0.26.0",
		"svelte-meta-tags": "^4.6.0"
	}
}
