#!/usr/bin/env bash
set -euo pipefail
#MISE description="Build and deploy landing to Dokku"

APP="landing"
TAG="${1:-$(git rev-parse --short HEAD)}"
IMAGE="app/${APP}:${TAG}"

BUILD_ARGS=()
if [[ "${1:-}" == "--clean" ]]; then
	echo "Clean build (--no-cache)..."
	BUILD_ARGS=(--no-cache)
fi

echo "Building ${IMAGE}..."
docker build "${BUILD_ARGS[@]}" -t "${IMAGE}" --build-arg "GIT_REV=$(git rev-parse HEAD)" .

echo "Deploying to lescayes..."
docker save "${IMAGE}" | ssh dokku.olamaelcu.net "git:load-image ${APP} ${IMAGE}" 2>&1

echo "Done."
