#!/usr/bin/env bash
set -euo pipefail
#MISE description="Build and deploy landing to Dokku"

APP="landing"
TAG="${1:-$(git rev-parse --short HEAD)}"
IMAGE="app/${APP}:${TAG}"

BUILD_ARGS=()
if [[ "${1:-}" == "--clean" ]]; then
	echo "Clean build (--no-cache)..."
	BUILD_ARGS=(--no-cache)
fi

echo "Building ${IMAGE}..."
docker build "${BUILD_ARGS[@]}" -t "${IMAGE}" .

echo "Deploying to lescayes..."
docker save "${IMAGE}" | ssh dokku.olamaelcu.net "dokku git:from-image ${APP} ${IMAGE}"

ssh dokku.olamaelcu.net "dokku ps:deploy ${APP}"

echo "Done."
